<%- include('partials/header') %>

    <!-- Page Header Start -->
    <div class="container-fluid page-header py-5 mb-5">
        <div class="container py-5">
            <h1 class="display-3 text-white mb-3 animated slideInDown">Testimonial</h1>
            <nav aria-label="breadcrumb animated slideInDown">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a class="text-white" href="/">Home</a></li>
                    <li class="breadcrumb-item text-white active" aria-current="page">Testimonial</li>
                </ol>
            </nav>
        </div>
    </div>
    <!-- Page Header End -->

    <!-- Testimonial Start -->
    <div class="container-xxl py-5 wow fadeInUp" data-wow-delay="0.1s">
        <div class="container">
            <div class="text-center">
                <h6 class="section-title bg-white text-center text-primary px-3">Testimonial</h6>
                <h1 class="mb-5">Our Students Say!</h1>
            </div>
            <div class="owl-carousel testimonial-carousel position-relative">
                <% [
                    { img:'testimonial-1.jpg', name:'Emily Clark',    role:'UI Designer',       text:'This platform transformed my career. The courses are engaging and the instructors are world-class. I got my first freelance client within a month of completing the design course!' },
                    { img:'testimonial-2.jpg', name:'Michael Lee',    role:'Software Developer', text:'I completed three courses here and landed my dream job. The content is practical, up-to-date, and the community support is amazing. Worth every penny.' },
                    { img:'testimonial-3.jpg', name:'Sarah Johnson',  role:'Digital Marketer',  text:'Excellent learning experience! The hands-on projects really help solidify the concepts. I went from zero to running my own digital marketing agency.' },
                    { img:'testimonial-4.jpg', name:'David Kim',      role:'Entrepreneur',       text:'The online library alone is worth the subscription. Top-quality content, amazing instructors, and a very supportive learning community.' },
                    { img:'testimonial-1.jpg', name:'Priya Mehta',    role:'Graphic Designer',  text:'I had no design background whatsoever. After just two courses I was able to create professional-level graphics. The instructors explain everything so clearly!' },
                    { img:'testimonial-2.jpg', name:'Carlos Rivera',  role:'Video Editor',       text:'Best investment I ever made in my education. The video editing course is incredibly detailed and the feedback from instructors is always constructive and fast.' },
                ].forEach(function(t) { %>
                <div class="testimonial-item text-center">
                    <img class="border rounded-circle p-2 mx-auto mb-3" src="/public/<%= t.img %>" style="width:80px;height:80px;" alt="<%= t.name %>" loading="lazy">
                    <h5 class="mb-0"><%= t.name %></h5>
                    <p><%= t.role %></p>
                    <div class="testimonial-text bg-light text-center p-4">
                        <p class="mb-0"><%= t.text %></p>
                    </div>
                </div>
                <% }); %>
            </div>
        </div>
    </div>
    <!-- Testimonial End -->

    <!-- Dynamic Video Testimonials Start -->
    <% if (typeof videos !== 'undefined' && videos.length > 0) { %>
    <div class="container-xxl py-5 wow fadeInUp" data-wow-delay="0.1s" id="video-testimonials">
        <div class="container">
            <div class="text-center mb-5">
                <h6 class="section-title bg-white text-center text-primary px-3">Video Stories</h6>
                <h1 class="mb-2">Parent &amp; Student Experiences</h1>
                <p class="text-secondary">Watch real feedback from our Kualakubs families</p>
            </div>
            <% 
              const catNames = Object.keys(videoGroups || {}).filter(k => videoGroups[k] && videoGroups[k].length > 0);
            %>
            <% if (catNames.length > 0) { %>
                <!-- Video Category Filter Selector -->
                <div class="video-category-filters">
                    <button type="button" class="video-filter-btn active" data-category="all">
                        All (<%= videos.length %>)
                    </button>
                    <% catNames.forEach(function(cat) { %>
                        <button type="button" class="video-filter-btn" data-category="<%= cat %>">
                            <%= cat.replace(/-/g, ' ') %> (<%= videoGroups[cat].length %>)
                        </button>
                    <% }); %>
                </div>
            <% } %>

            <!-- "All" Videos Pane -->
            <div class="video-category-pane" data-pane="all">
                <% if (videos.length > 3) { %>
                    <!-- Video Slider Carousel (> 3 videos) -->
                    <div class="owl-carousel video-carousel position-relative">
                        <% videos.forEach(function(vid) { %>
                            <div class="h-100 p-2">
                                <div class="video-testimonial-card h-100"
                                    style="position:relative; border-radius:18px; overflow:hidden; box-shadow:0 8px 24px rgba(61, 6, 75, 0.08); background:#ffffff; display:flex; flex-direction:column; border:1px solid rgba(61, 6, 75, 0.06);">
                                    <% if (vid.section && vid.section !== 'uncategorized') { %>
                                        <div class="video-overlay-badge">
                                            <span>
                                                <span class="cat-icon-dark"><i class="fas fa-folder"></i></span>
                                                <%= vid.section.replace(/-/g, ' ') %>
                                            </span>
                                        </div>
                                    <% } %>
                                    <div style="background:#0e0212; position:relative; overflow:hidden;">
                                        <video controls playsinline preload="none" style="width:100%; aspect-ratio:16/9; display:block; object-fit:contain; background:#000;">
                                            <source src="<%= vid.url %>" type="video/mp4">
                                            Your browser does not support the video tag.
                                        </video>
                                    </div>
                                    <% if (vid.testimonial || vid.author) { %>
                                        <div class="p-4" style="flex:1; display:flex; flex-direction:column; justify-content:space-between; background:#ffffff;">
                                            <div>
                                                <% if (vid.testimonial) { %>
                                                    <div class="position-relative">
                                                        <i class="fas fa-quote-left me-2 text-primary opacity-25" style="font-size: 1.1rem;"></i>
                                                        <p class="mb-0 text-muted fst-italic" style="font-size: 0.95rem; line-height: 1.6; display: inline;">
                                                            “<%= vid.testimonial %>”
                                                        </p>
                                                    </div>
                                                <% } %>
                                            </div>
                                            <% if (vid.author) { %>
                                                <div class="d-flex align-items-center pt-3 border-top mt-3" style="border-color: #f1e9f7 !important;">
                                                    <div class="rounded-circle d-flex align-items-center justify-content-center me-3 text-white fw-bold shadow-sm"
                                                        style="width:38px; height:38px; background:linear-gradient(135deg, #3d064b, #7b1fa2); font-size:0.9rem; flex-shrink:0;">
                                                        <%= vid.author.charAt(0).toUpperCase() %>
                                                    </div>
                                                    <div style="overflow:hidden;">
                                                        <h6 class="mb-0 fw-bold text-truncate" style="font-size:0.92rem; color: #3d064b;"><%= vid.author %></h6>
                                                    </div>
                                                </div>
                                            <% } %>
                                        </div>
                                    <% } %>
                                </div>
                            </div>
                        <% }); %>
                    </div>
                <% } else { %>
                    <!-- Static Grid (<= 3 videos) -->
                    <div class="row g-4 align-items-stretch justify-content-center">
                        <% videos.forEach(function(vid, idx) { %>
                            <div class="col-lg-4 col-md-6 wow fadeInUp" data-wow-delay="<%= (idx % 3) * 0.15 %>s">
                                <div class="video-testimonial-card h-100"
                                    style="position:relative; border-radius:18px; overflow:hidden; box-shadow:0 8px 24px rgba(61, 6, 75, 0.08); background:#ffffff; display:flex; flex-direction:column; border:1px solid rgba(61, 6, 75, 0.06); transition:transform 0.3s ease, box-shadow 0.3s ease;">
                                    <% if (vid.section && vid.section !== 'uncategorized') { %>
                                        <div class="video-overlay-badge">
                                            <span>
                                                <span class="cat-icon-dark"><i class="fas fa-folder"></i></span>
                                                <%= vid.section.replace(/-/g, ' ') %>
                                            </span>
                                        </div>
                                    <% } %>
                                    <div style="background:#0e0212; position:relative; overflow:hidden;">
                                        <video controls playsinline preload="none" style="width:100%; aspect-ratio:16/9; display:block; object-fit:contain; background:#000;">
                                            <source src="<%= vid.url %>" type="video/mp4">
                                            Your browser does not support the video tag.
                                        </video>
                                    </div>
                                    <% if (vid.testimonial || vid.author) { %>
                                        <div class="p-4" style="flex:1; display:flex; flex-direction:column; justify-content:space-between; background:#ffffff;">
                                            <div>
                                                <% if (vid.testimonial) { %>
                                                    <div class="position-relative">
                                                        <i class="fas fa-quote-left me-2 text-primary opacity-25" style="font-size: 1.1rem;"></i>
                                                        <p class="mb-0 text-muted fst-italic" style="font-size: 0.95rem; line-height: 1.6; display: inline;">
                                                            “<%= vid.testimonial %>”
                                                        </p>
                                                    </div>
                                                <% } %>
                                            </div>
                                            <% if (vid.author) { %>
                                                <div class="d-flex align-items-center pt-3 border-top mt-3" style="border-color: #f1e9f7 !important;">
                                                    <div class="rounded-circle d-flex align-items-center justify-content-center me-3 text-white fw-bold shadow-sm"
                                                        style="width:38px; height:38px; background:linear-gradient(135deg, #3d064b, #7b1fa2); font-size:0.9rem; flex-shrink:0;">
                                                        <%= vid.author.charAt(0).toUpperCase() %>
                                                    </div>
                                                    <div style="overflow:hidden;">
                                                        <h6 class="mb-0 fw-bold text-truncate" style="font-size:0.92rem; color: #3d064b;"><%= vid.author %></h6>
                                                    </div>
                                                </div>
                                            <% } %>
                                        </div>
                                    <% } %>
                                </div>
                            </div>
                        <% }); %>
                    </div>
                <% } %>
            </div>

            <!-- Individual Category Panes -->
            <% catNames.forEach(function(cat) { var catList = videoGroups[cat]; %>
                <div class="video-category-pane" data-pane="<%= cat %>" style="display:none;">
                    <% if (catList.length > 3) { %>
                        <!-- Slider (> 3 videos) -->
                        <div class="owl-carousel video-carousel position-relative">
                            <% catList.forEach(function(vid) { %>
                                <div class="h-100 p-2">
                                    <div class="video-testimonial-card h-100"
                                        style="position:relative; border-radius:18px; overflow:hidden; box-shadow:0 8px 24px rgba(61, 6, 75, 0.08); background:#ffffff; display:flex; flex-direction:column; border:1px solid rgba(61, 6, 75, 0.06);">
                                        <div class="video-overlay-badge">
                                            <span>
                                                <span class="cat-icon-dark"><i class="fas fa-folder"></i></span>
                                                <%= cat.replace(/-/g, ' ') %>
                                            </span>
                                        </div>
                                        <div style="background:#0e0212; position:relative; overflow:hidden;">
                                            <video controls playsinline preload="none" style="width:100%; aspect-ratio:16/9; display:block; object-fit:contain; background:#000;">
                                                <source src="<%= vid.url %>" type="video/mp4">
                                                Your browser does not support the video tag.
                                            </video>
                                        </div>
                                        <% if (vid.testimonial || vid.author) { %>
                                            <div class="p-4" style="flex:1; display:flex; flex-direction:column; justify-content:space-between; background:#ffffff;">
                                                <div>
                                                    <% if (vid.testimonial) { %>
                                                        <div class="position-relative">
                                                            <i class="fas fa-quote-left me-2 text-primary opacity-25" style="font-size: 1.1rem;"></i>
                                                            <p class="mb-0 text-muted fst-italic" style="font-size: 0.95rem; line-height: 1.6; display: inline;">
                                                                “<%= vid.testimonial %>”
                                                            </p>
                                                        </div>
                                                    <% } %>
                                                </div>
                                                <% if (vid.author) { %>
                                                    <div class="d-flex align-items-center pt-3 border-top mt-3" style="border-color: #f1e9f7 !important;">
                                                        <div class="rounded-circle d-flex align-items-center justify-content-center me-3 text-white fw-bold shadow-sm"
                                                            style="width:38px; height:38px; background:linear-gradient(135deg, #3d064b, #7b1fa2); font-size:0.9rem; flex-shrink:0;">
                                                            <%= vid.author.charAt(0).toUpperCase() %>
                                                        </div>
                                                        <div style="overflow:hidden;">
                                                            <h6 class="mb-0 fw-bold text-truncate" style="font-size:0.92rem; color: #3d064b;"><%= vid.author %></h6>
                                                        </div>
                                                    </div>
                                                <% } %>
                                            </div>
                                        <% } %>
                                    </div>
                                </div>
                            <% }); %>
                        </div>
                    <% } else { %>
                        <!-- Grid (<= 3 videos) -->
                        <div class="row g-4 align-items-stretch justify-content-center">
                            <% catList.forEach(function(vid, idx) { %>
                                <div class="col-lg-4 col-md-6 wow fadeInUp" data-wow-delay="<%= (idx % 3) * 0.15 %>s">
                                    <div class="video-testimonial-card h-100"
                                        style="position:relative; border-radius:18px; overflow:hidden; box-shadow:0 8px 24px rgba(61, 6, 75, 0.08); background:#ffffff; display:flex; flex-direction:column; border:1px solid rgba(61, 6, 75, 0.06); transition:transform 0.3s ease, box-shadow 0.3s ease;">
                                        <div class="video-overlay-badge">
                                            <span>
                                                <span class="cat-icon-dark"><i class="fas fa-folder"></i></span>
                                                <%= cat.replace(/-/g, ' ') %>
                                            </span>
                                        </div>
                                        <div style="background:#0e0212; position:relative; overflow:hidden;">
                                            <video controls playsinline preload="none" style="width:100%; aspect-ratio:16/9; display:block; object-fit:contain; background:#000;">
                                                <source src="<%= vid.url %>" type="video/mp4">
                                                Your browser does not support the video tag.
                                            </video>
                                        </div>
                                        <% if (vid.testimonial || vid.author) { %>
                                            <div class="p-4" style="flex:1; display:flex; flex-direction:column; justify-content:space-between; background:#ffffff;">
                                                <div>
                                                    <% if (vid.testimonial) { %>
                                                        <div class="position-relative">
                                                            <i class="fas fa-quote-left me-2 text-primary opacity-25" style="font-size: 1.1rem;"></i>
                                                            <p class="mb-0 text-muted fst-italic" style="font-size: 0.95rem; line-height: 1.6; display: inline;">
                                                                “<%= vid.testimonial %>”
                                                            </p>
                                                        </div>
                                                    <% } %>
                                                </div>
                                                <% if (vid.author) { %>
                                                    <div class="d-flex align-items-center pt-3 border-top mt-3" style="border-color: #f1e9f7 !important;">
                                                        <div class="rounded-circle d-flex align-items-center justify-content-center me-3 text-white fw-bold shadow-sm"
                                                            style="width:38px; height:38px; background:linear-gradient(135deg, #3d064b, #7b1fa2); font-size:0.9rem; flex-shrink:0;">
                                                            <%= vid.author.charAt(0).toUpperCase() %>
                                                        </div>
                                                        <div style="overflow:hidden;">
                                                            <h6 class="mb-0 fw-bold text-truncate" style="font-size:0.92rem; color: #3d064b;"><%= vid.author %></h6>
                                                        </div>
                                                    </div>
                                                <% } %>
                                            </div>
                                        <% } %>
                                    </div>
                                </div>
                            <% }); %>
                        </div>
                    <% } %>
                </div>
            <% }); %>
        </div>
    </div>
    <% } %>

<%- include('partials/footer') %>
