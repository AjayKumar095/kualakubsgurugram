<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= pageTitle %> | <%= siteName %></title>
    <link rel="icon" href="/public/fav-icon.png">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800&display=swap" rel="stylesheet">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }

        body {
            font-family: 'Nunito', sans-serif;
            min-height: 100vh;
            background: linear-gradient(135deg, #3d064b 0%, #6a0080 40%, #ff6b35 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            position: relative;
            overflow: hidden;
        }

        body::before {
            content: '';
            position: absolute;
            width: 500px; height: 500px;
            background: rgba(255,255,255,0.05);
            border-radius: 50%;
            top: -150px; left: -150px;
            animation: float 8s ease-in-out infinite;
        }
        body::after {
            content: '';
            position: absolute;
            width: 350px; height: 350px;
            background: rgba(255,255,255,0.04);
            border-radius: 50%;
            bottom: -100px; right: -100px;
            animation: float 6s ease-in-out infinite reverse;
        }

        @keyframes float {
            0%, 100% { transform: translateY(0); }
            50% { transform: translateY(-20px); }
        }

        .login-card {
            background: rgba(255,255,255,0.08);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border: 1px solid rgba(255,255,255,0.2);
            border-radius: 24px;
            padding: 3rem 2.5rem;
            width: 100%;
            max-width: 420px;
            position: relative;
            z-index: 10;
            box-shadow: 0 25px 50px rgba(0,0,0,0.3);
        }

        .logo-wrap {
            text-align: center;
            margin-bottom: 2rem;
        }
        .logo-wrap img {
            width: 160px;
            filter: brightness(0) invert(1);
        }

        .admin-badge {
            display: inline-block;
            background: rgba(255,186,0,0.2);
            border: 1px solid rgba(255,186,0,0.5);
            color: #ffba00;
            font-size: 0.75rem;
            font-weight: 700;
            letter-spacing: 2px;
            text-transform: uppercase;
            padding: 4px 14px;
            border-radius: 20px;
            margin-bottom: 1.5rem;
        }

        h2 {
            color: #fff;
            font-weight: 800;
            font-size: 1.6rem;
            margin-bottom: 0.3rem;
        }
        .subtitle {
            color: rgba(255,255,255,0.6);
            font-size: 0.9rem;
            margin-bottom: 2rem;
        }

        .form-label {
            color: rgba(255,255,255,0.85);
            font-weight: 600;
            font-size: 0.875rem;
            margin-bottom: 6px;
        }

        .form-control {
            background: rgba(255,255,255,0.1);
            border: 1px solid rgba(255,255,255,0.2);
            border-radius: 12px;
            color: #fff;
            padding: 12px 16px;
            font-size: 0.95rem;
            transition: all 0.3s;
        }
        .form-control::placeholder { color: rgba(255,255,255,0.4); }
        .form-control:focus {
            background: rgba(255,255,255,0.15);
            border-color: #ffba00;
            box-shadow: 0 0 0 3px rgba(255,186,0,0.2);
            color: #fff;
            outline: none;
        }

        .input-group-text {
            background: rgba(255,255,255,0.1);
            border: 1px solid rgba(255,255,255,0.2);
            border-right: none;
            border-radius: 12px 0 0 12px;
            color: rgba(255,255,255,0.6);
        }
        .input-group .form-control { border-radius: 0 12px 12px 0; }

        .btn-login {
            background: linear-gradient(135deg, #ffba00, #ff6b35);
            border: none;
            border-radius: 12px;
            color: #3d064b;
            font-weight: 800;
            font-size: 1rem;
            padding: 13px;
            width: 100%;
            transition: all 0.3s;
            letter-spacing: 0.5px;
        }
        .btn-login:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(255,186,0,0.4);
            color: #3d064b;
        }
        .btn-login:active { transform: translateY(0); }

        .alert-error {
            background: rgba(220,53,69,0.15);
            border: 1px solid rgba(220,53,69,0.4);
            color: #ff8080;
            border-radius: 12px;
            padding: 12px 16px;
            font-size: 0.875rem;
            margin-bottom: 1.2rem;
        }
        .alert-success {
            background: rgba(40,167,69,0.15);
            border: 1px solid rgba(40,167,69,0.4);
            color: #80ff9e;
            border-radius: 12px;
            padding: 12px 16px;
            font-size: 0.875rem;
            margin-bottom: 1.2rem;
        }

        .back-link {
            display: block;
            text-align: center;
            color: rgba(255,255,255,0.5);
            font-size: 0.85rem;
            margin-top: 1.5rem;
            text-decoration: none;
            transition: color 0.2s;
        }
        .back-link:hover { color: #ffba00; }

        .toggle-pw {
            background: transparent;
            border: none;
            color: rgba(255,255,255,0.5);
            cursor: pointer;
            position: absolute;
            right: 14px;
            top: 50%;
            transform: translateY(-50%);
            padding: 0;
            transition: color 0.2s;
        }
        .toggle-pw:hover { color: #ffba00; }
        .pw-wrap { position: relative; }
    </style>
</head>
<body>
    <div class="login-card">
        <div class="logo-wrap">
            <img src="/public/KUALAKUBS-LOGO-1.png" alt="Kualakubs Logo">
        </div>

        <div class="text-center">
            <span class="admin-badge"><i class="fas fa-shield-alt me-1"></i> Admin Panel</span>
            <h2>Welcome Back</h2>
            <p class="subtitle">Sign in to manage content</p>
        </div>

        <% if (error && error.length > 0) { %>
            <div class="alert-error">
                <i class="fas fa-exclamation-circle me-2"></i><%= error[0] %>
            </div>
        <% } %>
        <% if (success && success.length > 0) { %>
            <div class="alert-success">
                <i class="fas fa-check-circle me-2"></i><%= success[0] %>
            </div>
        <% } %>

        <form method="POST" action="/admin/login" autocomplete="off">
            <div class="mb-3">
                <label class="form-label" for="username">
                    <i class="fas fa-user me-1"></i> Username
                </label>
                <input type="text" id="username" name="username" class="form-control"
                       placeholder="Enter your username" required autocomplete="username">
            </div>

            <div class="mb-4">
                <label class="form-label" for="password">
                    <i class="fas fa-lock me-1"></i> Password
                </label>
                <div class="pw-wrap">
                    <input type="password" id="password" name="password" class="form-control"
                           placeholder="Enter your password" required autocomplete="current-password">
                    <button type="button" class="toggle-pw" onclick="togglePw()" id="toggleBtn">
                        <i class="fas fa-eye" id="eyeIcon"></i>
                    </button>
                </div>
            </div>

            <button type="submit" class="btn-login">
                <i class="fas fa-sign-in-alt me-2"></i> Sign In
            </button>
        </form>

        <a href="/" class="back-link">
            <i class="fas fa-arrow-left me-1"></i> Back to Website
        </a>
    </div>

    <script>
        function togglePw() {
            const pw  = document.getElementById('password');
            const eye = document.getElementById('eyeIcon');
            if (pw.type === 'password') {
                pw.type = 'text';
                eye.className = 'fas fa-eye-slash';
            } else {
                pw.type = 'password';
                eye.className = 'fas fa-eye';
            }
        }
    </script>
</body>
</html>
